Yin gitar_yin;

int main(void) {

	uint8_t sistem_aktif = 1;
		uint8_t buton_eski_durum = 1;


 	arm_rfft_fast_init_f32(&fftHandler, FFT_BUFFER_SIZE);
	RCC_Init();
	GPIO_Init();
	TIM2_Init();
	ADC1_Init();
	DMA2_Stream6_Init();
	DMA2_Stream0_Init();
	DMA2_Stream1_Init();
	Usart_Init();
	NVIC_Init();




	Yin_init(&gitar_yin, 512, 0.30f);
	while (1) {
		uint8_t buton_guncel_durum = (GPIOA->IDR & (1 << 2)) ? 1 : 0;


				if (buton_eski_durum == 1 && buton_guncel_durum == 0) {

					sistem_aktif = !sistem_aktif; // Durumu tersine çevir (1 ise 0, 0 ise 1 yap)

					for(volatile int i = 0; i < 50000; i++);
				}

				buton_eski_durum = buton_guncel_durum;

		if (sistem_aktif) {
					if (veridoldu == 2) {
						Process_Buffer();
						veridoldu = 0;
					}
				} else {
					veridoldu = 0;
				}

	}
}

void Process_Buffer() {

	for (int n = 0; n < FFT_BUFFER_SIZE; n++) {
		fftbuffin[n] = ((float32_t) adc_buffer[n] - 2048.0f)	;
	}

	float raw = Yin_getPitch(&gitar_yin, fftbuffin);
	pitch_history[pitch_idx++ % MEDIAN_SIZE] = raw;

	// Basit medyan için sırala
	float sorted[MEDIAN_SIZE];
	memcpy(sorted, pitch_history, sizeof(sorted));
	// bubble sort (küçük N için yeterli)
	for (int i = 0; i < MEDIAN_SIZE-1; i++)
	    for (int j = 0; j < MEDIAN_SIZE-1-i; j++)
	        if (sorted[j] > sorted[j+1]) {
	            float tmp = sorted[j]; sorted[j] = sorted[j+1]; sorted[j+1] = tmp;
	        }

	maks_hz = sorted[MEDIAN_SIZE / 2]; // ortanca değer
	    tx_buffer[0] = 0xAA;
	    memcpy(&tx_buffer[1], &maks_hz, 4);
	    DMA2_Stream6->CR &= ~(1 << 0);
	    while(DMA2_Stream6->CR & (1 << 0));
	    //FLAG Clean
	    DMA2->HIFCR |= (1 << 21) | (1 << 19) | (1 << 18) | (1 << 16);

	    DMA2_Stream6->M0AR = (uint32_t)tx_buffer;
	    DMA2_Stream6->NDTR = 5;
	    DMA2_Stream6->CR |= (1 << 0);

}

void DMA2_Stream0_IRQHandler(void) {
	//When half of buffer fill flag set 1;
	if (DMA2->LISR & (1 << 4)) {
		DMA2->LIFCR = (1 << 4);
		veridoldu = 1;

	}
	if (DMA2->LISR & (1 << 5)) {
		DMA2->LIFCR = (1 << 5);
		veridoldu = 2;
	}
}



